APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Optional — gates Step 1's purchase form behind a "sign up for updates" form until this date
# (per sso.md §11). Leave unset to disable the gate.
# PUBLIC_LAUNCH_AT=2026-11-11

# Optional — recipient for the daily Finance report (sso.md §10). Falls back to every Admin-role
# user if unset.
# FINANCE_REPORT_EMAIL=finance@empowerhci.com

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must stay above ProcessIntakeUpload's own $timeout (180s) — otherwise the worker treats a still-
# running job as lost and re-queues it, causing duplicate AI extraction on the larger questionnaires.
DB_QUEUE_RETRY_AFTER=200

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Connection/socket timeout for the smtp mailer. Without this, an unreachable or slow mail host
# hangs indefinitely — previously caused the checkout page to hit a 504 while sending the
# post-payment emails synchronously. Those emails are now queued (see WelcomeCredentialsMail,
# AdminPaymentReceivedMail, ClientPaymentReceiptMail), but this still bounds the queue worker itself.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

CLOVER_MTBC_BASE_URL=
CLOVER_MTBC_USERNAME=
CLOVER_MTBC_PASSWORD=
CLOVER_MTBC_BUSINESS_NAME=

# MTBC's Empower Payment API — tokenize/detokenize + Create_Charge, used for free trial card
# storage and recurring annual billing (see plan.md "Phase 2" updates). A separate API/host from
# CLOVER_MTBC_* above; do not merge the two.
EMPOWER_PAYMENT_API_BASE_URL=
EMPOWER_PAYMENT_API_USERNAME=
EMPOWER_PAYMENT_API_PASSWORD=
EMPOWER_PAYMENT_API_AES_KEY=
# Create_Charge's body-level username/password default to CLOVER_MTBC_USERNAME/PASSWORD above
# (confirmed to be the same credentials) — only set these if that ever needs to differ.
# EMPOWER_PAYMENT_API_CHARGE_USERNAME=
# EMPOWER_PAYMENT_API_CHARGE_PASSWORD=
# EMPOWER_PAYMENT_API_BUSINESS_NAME=
# EMPOWER_PAYMENT_API_TRIAL_REMINDER_DAYS=3

# MTBC's EmpowerSSOAPI — single-endpoint credential verification for the "Sign in with
# CareCloud"/"Sign in with talkEHR" login buttons.
EMPOWER_SSO_API_BASE_URL=

CARECLOUD_MSA_URL=

FINANCE_REPORT_EMAIL=

VITE_APP_NAME="${APP_NAME}"
